{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order",
  "description": "Order object schema for Petstore API",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "description": "Unique identifier for the order"
    },
    "petId": {
      "type": "integer",
      "format": "int64",
      "description": "ID of the pet being ordered"
    },
    "quantity": {
      "type": "integer",
      "format": "int32",
      "minimum": 1,
      "description": "Number of pets ordered"
    },
    "shipDate": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated ship date"
    },
    "status": {
      "type": "string",
      "enum": ["placed", "approved", "delivered"],
      "description": "Order status"
    },
    "complete": {
      "type": "boolean",
      "description": "Whether the order is complete"
    }
  }
}
